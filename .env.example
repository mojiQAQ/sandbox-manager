# Sandbox Manager 环境变量配置
# 复制此文件为 .env 并根据需要修改

# OpenSandbox server 连接
SBXMGR_OPENSANDBOX_HOST=localhost
SBXMGR_OPENSANDBOX_PORT=8080
SBXMGR_OPENSANDBOX_API_KEY=
SBXMGR_OPENSANDBOX_PROTOCOL=http

# 数据库路径
SBXMGR_DATABASE_PATH=data/sandbox_manager.db

# Docker 镜像前缀
SBXMGR_DOCKER_IMAGE_PREFIX=sbxmgr

# 沙盒默认超时时间（分钟）
SBXMGR_DEFAULT_TIMEOUT_MINUTES=60

# 服务配置
SBXMGR_HOST=0.0.0.0
SBXMGR_PORT=8000
SBXMGR_DEBUG=false
